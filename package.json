{
  "name": "azure-branch-diff",
  "productName": "Azure Branch Diff",
  "version": "1.4.2",
  "description": "Comparer des branches Azure DevOps, créer des PR et résoudre les conflits",
  "author": "Khalil Benazzouz",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "azure-devops-node-api": "^17.0.1",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "dompurify": "^3.4.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/khalilbenaz/azure-branch-diff.git"
  },
  "homepage": "https://khalilbenaz.github.io/azure-branch-diff/"
}
